{
  "name": "spyhaz",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "test": "node --test tests/*.test.js",
    "test:integration": "npm run build -w server && node --test tests/integration/*.test.js",
    "check": "npm run check -w server",
    "deploy:server": "npm run deploy -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "miniflare": "5.20261019.2-beta"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
