{
  "name": "spyhaz-game",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-21",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SpyhazRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SpyhazRoom"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://spyhaz.vercel.app,https://spyhaz-fhe8vpy9n-baraninsel0-4282s-projects.vercel.app,http://localhost:5173,http://127.0.0.1:5173"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
